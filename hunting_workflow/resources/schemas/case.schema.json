{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MosEcho/hunting-workflow/case.schema.json",
  "title": "Research case 1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "title": {
      "type": "string"
    },
    "vendor": {
      "type": "string"
    },
    "product": {
      "type": "string"
    },
    "product_description": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "trigger_conditions": {
      "type": "string"
    },
    "impact": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "fingerprint": {
      "type": "string"
    },
    "affected_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string",
            "enum": [
              "=",
              "<",
              "<=",
              ">",
              ">="
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "version",
          "relation",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "vulnerability_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "request",
              "response",
              "control_response",
              "product_version",
              "authorization",
              "screenshot",
              "search_record"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "path",
          "kind",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "basis": {
          "type": "string",
          "enum": [
            "self_hosted_lab",
            "written_authorization",
            "program_scope",
            "unknown"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authorized_targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "static",
            "unverified"
          ]
        },
        "human_reviewed": {
          "type": "boolean"
        },
        "review_note": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected": {
          "type": "string"
        },
        "actual": {
          "type": "string"
        },
        "cleanup": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "static",
              "unverified"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "text",
          "status",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "affected_instances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "target",
          "version",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "originality": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_checked",
            "inconclusive",
            "possible_duplicate",
            "duplicate",
            "reviewed_no_match"
          ]
        },
        "review_note": {
          "type": "string"
        },
        "searches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string"
              },
              "query": {
                "type": "string"
              },
              "checked_at": {
                "type": "string"
              },
              "result": {
                "type": "string"
              }
            },
            "required": [
              "source",
              "query",
              "checked_at",
              "result"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "severity": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "unrated"
          ]
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "remediation": {
      "type": "object",
      "properties": {
        "temporary": {
          "type": "string"
        },
        "permanent": {
          "type": "string"
        },
        "verification": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "contacts": {
      "type": "object",
      "properties": {
        "reporter": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "phone": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "supporter": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "phone": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "platform_review": {
      "type": "object",
      "properties": {
        "field_mapping_confirmed": {
          "type": "boolean"
        },
        "reviewed_at": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "synthetic"
  ],
  "additionalProperties": false
}
